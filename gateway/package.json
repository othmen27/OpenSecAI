{
  "name": "@opensecai/gateway",
  "version": "0.1.0-skeleton",
  "private": true,
  "description": "API Gateway — auth, rate limiting, routing",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run"
  },
  "dependencies": {
